# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres for Drizzle ---
# Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# URL-encode the password if it contains special characters.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Studio access (Phase 1: founder-only) ---
# Comma-separated list of emails allowed into /studio.
STUDIO_ALLOWLIST=founder@example.com
